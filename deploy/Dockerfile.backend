# Reproducible Java sources: pin the OTRYX RPC commit because it is not on Maven Central.
FROM maven:3.9.11-eclipse-temurin-21 AS builder
ARG OTRYX_RPC_SHA
RUN test -n "$OTRYX_RPC_SHA"
RUN git clone https://github.com/Ryan-Guizhou/otryx-rpc.git /opt/otryx-rpc \
    && cd /opt/otryx-rpc \
    && git checkout "$OTRYX_RPC_SHA" \
    && test "$(git rev-parse HEAD)" = "$OTRYX_RPC_SHA" \
    && mvn -B -ntp -pl :otryx-codegen,:otryx-spring-boot-starter,:otryx-registry-nacos -am -DskipTests install
WORKDIR /workspace
COPY pom.xml ./
COPY flow-contracts ./flow-contracts
COPY flow-scheduler-core ./flow-scheduler-core
COPY flow-scheduler ./flow-scheduler
COPY flow-engine ./flow-engine
COPY flow-dispatcher ./flow-dispatcher
COPY flow-worker-sdk ./flow-worker-sdk
COPY flow-worker-quickstart ./flow-worker-quickstart
COPY flow-api ./flow-api
COPY flow-metadata ./flow-metadata
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /apps
RUN useradd --system --uid 10001 --home /apps flow \
    && mkdir -p /apps/logs/nacos \
    && chown -R flow:flow /apps/logs
COPY --from=builder --chown=flow:flow /workspace/flow-api/target/flow-api-0.1.0-SNAPSHOT.jar /apps/flow-api.jar
COPY --from=builder --chown=flow:flow /workspace/flow-metadata/target/flow-metadata-0.1.0-SNAPSHOT.jar /apps/flow-metadata.jar
COPY --from=builder --chown=flow:flow /workspace/flow-scheduler/target/flow-scheduler-0.1.0-SNAPSHOT.jar /apps/flow-scheduler.jar
COPY --from=builder --chown=flow:flow /workspace/flow-engine/target/flow-engine-0.1.0-SNAPSHOT.jar /apps/flow-engine.jar
COPY --from=builder --chown=flow:flow /workspace/flow-dispatcher/target/flow-dispatcher-0.1.0-SNAPSHOT.jar /apps/flow-dispatcher.jar
COPY --from=builder --chown=flow:flow /workspace/flow-worker-quickstart/target/flow-worker-quickstart-0.1.0-SNAPSHOT.jar /apps/flow-worker-quickstart.jar
USER flow
ENTRYPOINT ["java", "-jar"]
CMD ["/apps/flow-api.jar"]
