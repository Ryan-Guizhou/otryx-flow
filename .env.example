# Copy to .env and choose unique strong credentials. .env must not be committed.
FLOW_DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
FLOW_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
FLOW_ADMIN_USERNAME=admin
FLOW_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
OTRYX_RPC_SHA=0addd7df17c5ba4a0b77e2d30e4c7c75d7ac31f2

# Nacos 3.2.4 standalone for isolated development only.
# Generate with: openssl rand -base64 48; openssl rand -hex 24
FLOW_NACOS_AUTH_TOKEN=REPLACE_WITH_RANDOM_BASE64_NACOS_TOKEN
FLOW_NACOS_IDENTITY_VALUE=REPLACE_WITH_RANDOM_NACOS_IDENTITY

# Optional local-only observability overlay; rotate before use.
FLOW_GRAFANA_ADMIN_USER=admin
FLOW_GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_GRAFANA_PASSWORD
